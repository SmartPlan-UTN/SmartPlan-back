{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "globalSetup": "<rootDir>/prepare-database.ts",
  "setupFiles": ["reflect-metadata", "<rootDir>/test-environment.ts"],
  "setupFilesAfterEnv": ["<rootDir>/reset-suite-database.ts"],
  "maxWorkers": 1,
  "testTimeout": 30000,
  "clearMocks": true,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
