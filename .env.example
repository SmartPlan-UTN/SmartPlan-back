# SmartPlan Back environment-variable template.
#
# Copy this file to `.env` and fill in the values. `.env` is in .gitignore and
# must never be committed: this file contains keys only, with no values.
#
#   cp .env.example .env
#
# The schema that validates these keys at startup is in
# src/config/environment-variables.ts.

# --- Application ---------------------------------------------------------------

# development | test | production. Opcional, por defecto development.
NODE_ENV=

# API HTTP port. Optional; defaults to 3001.
PORT=

# CORS origin allowed to consume the API. Optional; development defaults to the
# local Next.js server (http://localhost:3000).
#
# It must be an origin: scheme://host[:port], with no path or trailing slash.
# `https://app.smartplan.com` works; `https://app.smartplan.com/` does not.
FRONTEND_URL=

# --- Database -----------------------------------------------------------------
#
# There are two ways to configure the connection; one of them is required.
# If both are present, DATABASE_URL wins.

# Option A (production, Railway): complete connection string.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Option B (development): individual variables. These are also read by
# docker-compose.yml, so defining them here configures both the PostgreSQL
# container and the application.
DB_HOST=localhost
DB_PORT=5432
DB_USER=smartplan
DB_PASSWORD=smartplan
DB_NAME=smartplan

# Database SSL. Railway requires it; use false for local Docker.
DB_SSL=false

# --- Tests --------------------------------------------------------------------

# Database used by e2e tests. The tests drop and recreate its schema on every
# run, so it must NOT be the development database.
#
# Optional: when empty, <DB_NAME>_test is used, which is almost always correct.
# The database is created automatically on the first `pnpm test:e2e` run.
#
# The name must end in `_test`: tests refuse to start otherwise. It is not in
# src/config/environment-variables.ts because the application never reads it;
# only test/test-database.ts uses it.
DB_NAME_TEST=

# --- Autenticación ------------------------------------------------------------

# Secretos separados para access y refresh JWT. Mínimo 32 caracteres cada uno.
# Generá cada uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Envío transaccional de recuperación de contraseña mediante Resend.
RESEND_API_KEY=
EMAIL_FROM=

# --- Integraciones externas ---------------------------------------------------
# Railway S3-compatible private image bucket. Use Railway variable references;
# never commit the values.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

#
# Requeridas tanto por la API como por el worker: la generación de planes
# (CU17-CU23) corre en el worker, que llama a Gemini y Google Maps directamente.

# API key de Google Maps (CU48–CU52, CU17–CU23).
# Consola: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=
# Enable the nightly external sync trigger on exactly one API instance.
EXTERNAL_SYNC_SCHEDULER_ENABLED=true

# API key de Gemini (motor de recomendación, CU17–CU23).
# Consola: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini a usar. Opcional, por defecto gemini-3.6-flash.
GEMINI_MODEL=

# --- Mensajería y colas -------------------------------------------------------
#
# La cola la levanta docker-compose.yml junto con PostgreSQL (`pnpm db:up`).
# Panel de administración: http://localhost:15672 (usuario/clave de abajo).

# Conexión a RabbitMQ. Opcional: por defecto apunta al contenedor local
# (amqp://smartplan:smartplan@localhost:5672).
# En Railway va la URL de la red privada, nunca una pública.
RABBITMQ_URL=

# Usuario, clave y puerto del contenedor local. Los lee docker-compose.yml,
# no la app: la app arma la conexión entera con RABBITMQ_URL de arriba (una
# sola variable), no con estas sueltas. Si cambiás RABBITMQ_PORT porque ya
# tenés otro RabbitMQ en 5672, cambiá también el puerto dentro de
# RABBITMQ_URL — si solo cambiás uno, la app apunta al broker equivocado o
# falla con ECONNREFUSED sin ninguna pista de por qué.
RABBITMQ_USER=smartplan
RABBITMQ_PASSWORD=smartplan
RABBITMQ_PORT=5672
RABBITMQ_PANEL_PORT=15672

# Cuántos mensajes toma el worker a la vez. Opcional, por defecto 1.
RABBITMQ_PREFETCH=

# Intentos totales por trabajo, incluido el primero. Opcional, por defecto 3.
RABBITMQ_MAX_ATTEMPTS=

# Demoras entre reintentos en milisegundos, separadas por coma. Opcional, por
# defecto 5000,30000. Tiene que haber exactamente RABBITMQ_MAX_ATTEMPTS - 1
# valores, ni más ni menos: cada demora declara una cola de retry física, y el
# arranque falla si no coincide (ver validarCoherenciaDeReintentos).
#
# OJO: cambiar esto con las colas ya creadas hace que RabbitMQ rechace la
# redeclaración (PRECONDITION_FAILED) y el worker no arranque. Salida: borrar
# todas las colas smartplan.jobs.example.retry.* desde el panel
# (http://localhost:15672 -> Queues) y reiniciar el worker.
RABBITMQ_RETRY_DELAYS_MS=

# --- Recomendación (CU17-CU23) --------------------------------------------

# Máximo de solicitudes de generación de plan activas (pending/processing) por
# usuario. Protege el costo de Gemini/Maps ante un usuario que dispare muchas
# generaciones en paralelo. Opcional, por defecto 3.
MAX_ACTIVE_PLAN_REQUESTS_PER_USER=
