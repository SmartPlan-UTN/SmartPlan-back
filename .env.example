# Copiá este archivo a .env y completá los valores.
# El .env NO se commitea.

# Entorno: development | test | production
# Fija `synchronize` de TypeORM: true fuera de production, false en production.
NODE_ENV=development

# Puerto del servidor HTTP.
# 3001 para no chocar con el frontend, que usa 3000.
PORT=3001

# --- Base de datos ---------------------------------------------------------
# Opción A (desarrollo): variables sueltas. Son las mismas que lee
# docker-compose.yml, así que alcanza con definirlas una vez.
DB_HOST=localhost
DB_PORT=5432
DB_USER=smartplan
DB_PASSWORD=smartplan
DB_NAME=smartplan

# Opción B (producción, Railway): URL completa. Si está definida, tiene
# prioridad sobre las variables sueltas de arriba.
# DATABASE_URL=postgres://usuario:clave@host:5432/smartplan

# SSL contra la base. Railway lo necesita; en Docker local va en false.
DB_SSL=false
