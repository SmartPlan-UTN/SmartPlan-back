# Plantilla de variables de entorno de SmartPlan Back.
#
# Copiala a `.env` y completá los valores. `.env` está en .gitignore y no se
# commitea nunca: este archivo va sin valores, solo con las claves.
#
#   cp .env.example .env
#
# El esquema que valida estas claves al arrancar está en
# src/config/variables-entorno.ts.

# --- Aplicación ---------------------------------------------------------------

# development | test | production. Opcional, por defecto development.
NODE_ENV=

# Puerto HTTP de la API. Opcional, por defecto 3001.
PORT=

# Origen autorizado por CORS para consumir la API. Opcional; en desarrollo usa
# el servidor local de Next.js por defecto (http://localhost:3000).
#
# Tiene que ser un origen: esquema://host[:puerto], sin ruta ni barra final.
# `https://app.smartplan.com` sirve; `https://app.smartplan.com/` no arranca.
FRONTEND_URL=

# --- Base de datos ------------------------------------------------------------
#
# Hay dos formas de configurar la conexión y tiene que estar una de las dos.
# Si están las dos, gana DATABASE_URL.

# Forma A (producción, Railway): cadena de conexión completa.
# Formato: postgresql://usuario:clave@host:puerto/base
DATABASE_URL=

# Forma B (desarrollo): variables sueltas. Son las mismas que lee
# docker-compose.yml, así que definiéndolas acá quedan configurados a la vez el
# contenedor de PostgreSQL y la aplicación.
DB_HOST=localhost
DB_PORT=5432
DB_USER=smartplan
DB_PASSWORD=smartplan
DB_NAME=smartplan

# SSL contra la base. Railway lo necesita; en Docker local va en false.
DB_SSL=false

# --- Tests --------------------------------------------------------------------

# Base contra la que corren los tests e2e. Los tests borran y recrean el esquema
# en cada corrida, así que NO puede ser la misma que la de desarrollo.
#
# Es opcional: si la dejás vacía se usa <DB_NAME>_test, que es lo que querés casi
# siempre. La base se crea sola en la primera corrida de `pnpm test:e2e`.
#
# El nombre tiene que terminar en `_test`: los tests se niegan a arrancar contra
# una base que no lo cumpla. No está en el esquema de src/config/variables-entorno.ts
# porque la aplicación nunca la lee — solo la usa test/base-de-datos-de-prueba.ts.
DB_NAME_TEST=

# --- Autenticación ------------------------------------------------------------

# Secreto para firmar los JWT. Mínimo 32 caracteres.
# Generá uno con: openssl rand -base64 48
JWT_SECRET=

# --- Integraciones externas ---------------------------------------------------

# API key de Google Maps (CU48–CU52).
# Consola: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# API key de OpenAI (motor de recomendación, CU17–CU23).
# Consola: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# API key de Gemini (spike de motor de recomendación, ticket #32, CU17–CU23).
# Consola: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini a usar. Opcional, por defecto gemini-3.6-flash.
GEMINI_MODEL=
