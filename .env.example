# Plantilla de variables de entorno de SmartPlan Back.
#
# Copiala a `.env` y completá los valores. `.env` está en .gitignore y no se
# commitea nunca: este archivo va sin valores, solo con las claves.
#
#   cp .env.example .env
#
# El esquema que valida estas claves al arrancar está en
# src/config/variables-entorno.ts.

# --- Aplicación ---------------------------------------------------------------

# development | test | production. Opcional, por defecto development.
NODE_ENV=

# Puerto HTTP de la API. Opcional, por defecto 3001.
PORT=

# Origen autorizado por CORS para consumir la API. Opcional; en desarrollo usa
# el servidor local de Next.js por defecto (http://localhost:3000).
#
# Tiene que ser un origen: esquema://host[:puerto], sin ruta ni barra final.
# `https://app.smartplan.com` sirve; `https://app.smartplan.com/` no arranca.
FRONTEND_URL=

# --- Base de datos ------------------------------------------------------------
#
# Hay dos formas de configurar la conexión y tiene que estar una de las dos.
# Si están las dos, gana DATABASE_URL.

# Forma A (producción, Railway): cadena de conexión completa.
# Formato: postgresql://usuario:clave@host:puerto/base
DATABASE_URL=

# Forma B (desarrollo): variables sueltas. Son las mismas que lee
# docker-compose.yml, así que definiéndolas acá quedan configurados a la vez el
# contenedor de PostgreSQL y la aplicación.
DB_HOST=localhost
DB_PORT=5432
DB_USER=smartplan
DB_PASSWORD=smartplan
DB_NAME=smartplan

# SSL contra la base. Railway lo necesita; en Docker local va en false.
DB_SSL=false

# --- Tests --------------------------------------------------------------------

# Base contra la que corren los tests e2e. Los tests borran y recrean el esquema
# en cada corrida, así que NO puede ser la misma que la de desarrollo.
#
# Es opcional: si la dejás vacía se usa <DB_NAME>_test, que es lo que querés casi
# siempre. La base se crea sola en la primera corrida de `pnpm test:e2e`.
#
# El nombre tiene que terminar en `_test`: los tests se niegan a arrancar contra
# una base que no lo cumpla. No está en el esquema de src/config/variables-entorno.ts
# porque la aplicación nunca la lee — solo la usa test/base-de-datos-de-prueba.ts.
DB_NAME_TEST=

# --- Autenticación ------------------------------------------------------------

# Secretos separados para access y refresh JWT. Mínimo 32 caracteres cada uno.
# Generá cada uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Envío transaccional de recuperación de contraseña mediante Resend.
RESEND_API_KEY=
EMAIL_FROM=

# --- Integraciones externas ---------------------------------------------------

# API key de Google Maps (CU48–CU52).
# Consola: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# API key de Gemini (motor de recomendación, CU17–CU23).
# Consola: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini a usar. Opcional, por defecto gemini-3.6-flash.
GEMINI_MODEL=

# --- Mensajería y colas -------------------------------------------------------
#
# La cola la levanta docker-compose.yml junto con PostgreSQL (`pnpm db:up`).
# Panel de administración: http://localhost:15672 (usuario/clave de abajo).

# Conexión a RabbitMQ. Opcional: por defecto apunta al contenedor local
# (amqp://smartplan:smartplan@localhost:5672).
# En Railway va la URL de la red privada, nunca una pública.
RABBITMQ_URL=

# Usuario, clave y puerto del contenedor local. Los lee docker-compose.yml,
# no la app: la app arma la conexión entera con RABBITMQ_URL de arriba (una
# sola variable), no con estas sueltas. Si cambiás RABBITMQ_PORT porque ya
# tenés otro RabbitMQ en 5672, cambiá también el puerto dentro de
# RABBITMQ_URL — si solo cambiás uno, la app apunta al broker equivocado o
# falla con ECONNREFUSED sin ninguna pista de por qué.
RABBITMQ_USER=smartplan
RABBITMQ_PASSWORD=smartplan
RABBITMQ_PORT=5672
RABBITMQ_PANEL_PORT=15672

# Cuántos mensajes toma el worker a la vez. Opcional, por defecto 1.
RABBITMQ_PREFETCH=

# Intentos totales por trabajo, incluido el primero. Opcional, por defecto 3.
RABBITMQ_MAX_INTENTOS=

# Demoras entre reintentos en milisegundos, separadas por coma. Opcional, por
# defecto 5000,30000. Tiene que haber exactamente RABBITMQ_MAX_INTENTOS - 1
# valores, ni más ni menos: cada demora declara una cola de retry física, y el
# arranque falla si no coincide (ver validarCoherenciaDeReintentos).
#
# OJO: cambiar esto con las colas ya creadas hace que RabbitMQ rechace la
# redeclaración (PRECONDITION_FAILED) y el worker no arranque. Salida: borrar
# todas las colas smartplan.jobs.example.retry.* desde el panel
# (http://localhost:15672 -> Queues) y reiniciar el worker.
RABBITMQ_RETRY_DELAYS_MS=
