# Copy to .env.local (ignored by git). Values here win over .env.
# Local development must use a local database; a process that is not running on
# the deployment platform refuses any remote database unless you opt in with
# ALLOW_REMOTE_DATABASE=<exact host> (and, separately, ALLOW_REMOTE_MIGRATIONS=true).
NODE_ENV=development
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/smartplan
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartplan
DB_USER=postgres
DB_PASSWORD=<password>
DB_SSL=false
FRONTEND_URL=http://localhost:3000
RABBITMQ_URL=amqp://smartplan:smartplan@localhost:5672
# Bootstrap catalog: accept older verified prices for automatic recommendation.
# CATALOG_AUTO_RECOMMEND_MAX_PRICE_AGE_DAYS=365
